# Public pages and the valuation lab work without these service credentials.
# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional country-code form, e.g. 923001234567. No spaces or leading zero.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# PostgreSQL 15+. Use a dedicated application database; run migrations first.
DATABASE_URL=
# For RDS: PEM CA certificate, using literal \n between lines. Verify TLS.
# Avoid connection-string sslmode parameters when supplying this explicit CA.
DATABASE_CA_CERT=

# Use the exact browser origin. HTTPS is required for public production use.
AUTH_URL=http://localhost:3000
# Generate a unique 32+ byte random secret with your secret-management tooling.
AUTH_SECRET=
# Verified email accounts permitted to administer the platform (comma-separated).
ADMIN_EMAILS=

# SMTP URL supported by Amazon SES SMTP or Resend SMTP; URL-encode credentials.
# Example shape: smtps://USERNAME:PASSWORD@smtp.example.com:465
EMAIL_SERVER=
EMAIL_FROM=

# Only true behind a trusted reverse proxy that REPLACES X-Forwarded-For.
TRUST_PROXY=false
